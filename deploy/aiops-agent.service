[Unit]
Description=AIOps Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=aiops
Group=aiops
SupplementaryGroups=adm
WorkingDirectory=/opt/aiops-agent
EnvironmentFile=/etc/aiops-agent.env
Environment=AIOPS_DATA_DIR=/var/lib/aiops-agent PYTHONUNBUFFERED=1
ExecStart=/opt/aiops-agent/venv/bin/python -m aiops_agent.main -c /opt/aiops-agent/config.yaml run
# Alert whenever the service stops or crashes (runs after every stop, "-" = ignore errors)
ExecStopPost=-/opt/aiops-agent/venv/bin/python -m aiops_agent.main -c /opt/aiops-agent/config.yaml notify "AIOps agent stopped" "result=${SERVICE_RESULT} exit=${EXIT_STATUS}. systemd will restart it unless it was stopped manually."
Restart=always
RestartSec=5
StateDirectory=aiops-agent
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
